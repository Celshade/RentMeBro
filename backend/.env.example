DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Local dev defaults to SQLite (no DATABASE_URL needed).
# For Postgres (e.g. via docker-compose): postgres://user:password@db:5432/rentmebro
# DATABASE_URL=
# Connection reuse in seconds; leave unset for SQLite. Production sets
# this for Postgres.
# CONN_MAX_AGE=60

# How many trusted reverse proxies sit in front of the app. Leave at 0
# for local dev (no proxy). Production behind a CDN + reverse proxy
# must set this so client-IP-keyed throttling reads the real client
# address instead of the proxy's.
# NUM_PROXIES=0

# Production-only security flags (leave unset/False for local dev,
# which runs over plain HTTP):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=<seconds>
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Overrides the Django admin's URL path so it isn't published in a
# public repo. Leave unset for local dev.
# ADMIN_URL=admin/

# S3-backed media storage (Lease.document uploads). Leave unset for
# local dev, which falls back to the local filesystem.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# Local dev defaults to printing emails to the console in plain text
# (local-dev only; refuses to load unless DEBUG=True).
# EMAIL_BACKEND=config.email_backends.PlainTextConsoleEmailBackend
# Production switches to the real SMTP backend and sets the relay
# credentials below:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@rentmebro.example

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys). Cash App
# Pay must be enabled as a payment method on the account.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the standard webhook endpoint (payment_intent.succeeded
# on the platform's own account).
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for a second Dashboard webhook endpoint scoped to
# "events on connected accounts" (Connect > Webhooks). Needed because
# direct charges on a landlord's connected account don't fire events
# on the platform's own webhook endpoint. One endpoint here covers
# every connected landlord: each event's `account` field identifies
# which landlord it came from, which is how we see every landlord's
# payments (to update Invoice.status) without holding their funds.
# For local testing with `stripe listen`, the CLI signs both platform
# and Connect events with a single secret for the session, so this
# should be set to the SAME value as STRIPE_WEBHOOK_SECRET above. In
# production, with two real Dashboard-configured webhook endpoints,
# these will be two genuinely different secrets.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Base URL for mempool.space's REST API, used to poll for BTC invoice
# payments. Override for a testnet or self-hosted Esplora instance.
MEMPOOL_API_BASE_URL=https://mempool.space/api
