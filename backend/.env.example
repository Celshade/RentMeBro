DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Local dev defaults to SQLite (no DATABASE_URL needed).
# For Postgres (e.g. via docker-compose): postgres://user:password@db:5432/rentmebro
# DATABASE_URL=

# Local dev defaults to printing emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@rentmebro.local

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys). Cash App
# Pay must be enabled as a payment method on the account.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the standard webhook endpoint (payment_intent.succeeded
# on the platform's own account).
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for a second Dashboard webhook endpoint scoped to
# "events on connected accounts" (Connect > Webhooks). Needed because
# direct charges on a landlord's connected account don't fire events
# on the platform's own webhook endpoint. One endpoint here covers
# every connected landlord: each event's `account` field identifies
# which landlord it came from, which is how we see every landlord's
# payments (to update Invoice.status) without holding their funds.
# For local testing with `stripe listen`, the CLI signs both platform
# and Connect events with a single secret for the session, so this
# should be set to the SAME value as STRIPE_WEBHOOK_SECRET above. In
# production, with two real Dashboard-configured webhook endpoints,
# these will be two genuinely different secrets.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
